{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pflegemittelbox",
  "version": "1.0.0",
  "identifier": "com.leapingai.pflegemittelbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pflegemittelbox",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": []
  }
}
